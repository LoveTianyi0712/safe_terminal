{
  "full_scan": {
    "include_drives": [],
    "exclude_dirs": [
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "C:\\ProgramData\\Microsoft",
      "C:\\$Recycle.Bin",
      "C:\\System Volume Information"
    ],
    "max_depth": 5,
    "max_file_size_mb": 10,
    "text_extensions": [
      ".txt", ".log", ".ini", ".cfg", ".csv", ".xml",
      ".json", ".doc", ".docx", ".xls", ".xlsx", ".md", ".html", ".htm"
    ],
    "timeout_minutes": 30
  },
  "wechat_scan": {
    "exclude_dirs": ["Image", "Video", "Backup", "Emoticon", "Avatar"],
    "max_file_size_mb": 5
  }
}
