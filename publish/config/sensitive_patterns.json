[
  {
    "type": "手机号",
    "regex": "(?<!\\d)1[3-9]\\d{9}(?!\\d)"
  },
  {
    "type": "身份证号",
    "regex": "\\b[1-9]\\d{5}(18|19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]\\b"
  },
  {
    "type": "银行卡号",
    "regex": "\\b[3-9]\\d{15,18}\\b"
  },
  {
    "type": "IPv4地址",
    "regex": "\\b(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\b"
  },
  {
    "type": "住址",
    "regex": "[\\u4e00-\\u9fa5]{2,}(省|自治区)[\\u4e00-\\u9fa5]{2,}(市|州)[\\u4e00-\\u9fa5]{2,}(区|县|镇|乡)"
  }
]
