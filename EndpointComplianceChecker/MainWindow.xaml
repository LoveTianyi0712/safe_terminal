<Window x:Class="EndpointComplianceChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EndpointComplianceChecker.ViewModels"
        xmlns:conv="clr-namespace:EndpointComplianceChecker.Converters"
        Title="终端合规性检查工具 v1.1"
        Width="1000" Height="650"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}">

    <Window.Resources>
        <conv:StatusToBrushConverter   x:Key="StatusToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToColorConverter   x:Key="StringToColor"/>

        <!-- Check item list item style -->
        <Style x:Key="CheckItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log list box item: no padding -->
        <Style x:Key="LogItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🛡️ 终端合规性检查工具"
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#A8C6DA" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Foreground="#A8C6DA" FontSize="11">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="版本 v1.1  |  进度 {0:F0}%">
                            <Binding Path="OverallProgress"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!--  Left: Check Items List  -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Background="#F7FAFC"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <TextBlock Text="检查项目列表" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Items list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding CheckItems}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              BorderThickness="0" Background="Transparent"
                              ItemContainerStyle="{StaticResource CheckItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CheckItemViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Main row -->
                                    <Grid Grid.Row="0" Margin="14,10,14,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Numbered circle -->
                                        <Border Grid.Column="0" Width="24" Height="24"
                                                CornerRadius="12"
                                                Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                            <TextBlock Text="{Binding Order}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name + summary -->
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="11" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Status emoji -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusIcon}"
                                                   FontSize="15" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Grid>

                                    <!-- Sub-progress bar (only during full scan) -->
                                    <Border Grid.Row="1" Margin="14,0,14,8"
                                            Visibility="{Binding ShowSubProgress, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar Value="{Binding SubProgress, Mode=OneWay}"
                                                     Maximum="100" Height="5"
                                                     BorderThickness="0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  Grid Splitter  -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!--  Right: Real-time Log  -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log header -->
                    <Border Grid.Row="0" Background="#F7FAFC"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid>
                            <TextBlock Text="实时日志输出"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Content="清空日志"
                                    HorizontalAlignment="Right"
                                    Padding="10,4" FontSize="11" Cursor="Hand"
                                    Background="#EDF2F7" Foreground="#4A5568"
                                    BorderThickness="1" BorderBrush="#CBD5E0"
                                    Click="ClearLog_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Log output (dark terminal style) -->
                    <ListBox Grid.Row="1"
                             x:Name="LogListBox"
                             ItemsSource="{Binding LogLines}"
                             Background="#1A1A2E"
                             BorderThickness="0"
                             Padding="12,8"
                             FontFamily="Consolas, Courier New"
                             FontSize="12"
                             Foreground="#C9D1D9"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource LogItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{Binding Path=., Converter={StaticResource StringToColor}}"
                                           TextWrapping="NoWrap"
                                           Margin="0,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== BOTTOM BAR ===================== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Action buttons (use Margin instead of Spacing) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="▶  开始检查"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding CanStart}"
                            MinWidth="100" Margin="0,0,8,0"/>

                    <Button Content="⏹  停止"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            MinWidth="80" Margin="0,0,8,0"/>

                    <Button Content="💾  保存报告"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveReportCommand}"
                            IsEnabled="{Binding CanSaveReport}"
                            MinWidth="100" Margin="0,0,8,0"/>

                    <Button Content="📝  查看结果"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ReviewResultsCommand}"
                            IsEnabled="{Binding CanReviewResults}"
                            MinWidth="100" Margin="0,0,8,0"
                            Background="#2E86AB"
                            ToolTip="查看敏感文件列表，支持按类型过滤，可批量永久删除磁盘上的实际文件"/>

                    <Button Content="📋  配置规则"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="100"
                            Background="#718096"
                            Click="ConfigPatterns_Click"/>
                </StackPanel>

                <!-- Progress bar -->
                <Grid Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="整体进度" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:F0}%">
                                    <Binding Path="OverallProgress"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Grid.Row="1"
                                 Value="{Binding OverallProgress, Mode=OneWay}"
                                 Maximum="100" Height="8"
                                 BorderThickness="0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

