<Window x:Class="EndpointComplianceChecker.Views.SensitiveFileReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="敏感文件结果查看 / 编辑"
        Width="900" Height="580"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A5F" Padding="20,14">
            <StackPanel>
                <TextBlock Text="📋 敏感文件结果查看 / 编辑" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="可按文件类型过滤，选中后批量移除（不影响实际文件，仅从本次报告中排除）"
                           Foreground="#A8C6DA" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toolbar: filter + action buttons -->
        <Border Grid.Row="1" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="来源：" VerticalAlignment="Center" FontSize="12"
                           Foreground="#4A5568" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbSource" Grid.Column="1" Width="110" Height="28" FontSize="12"
                          Margin="0,0,14,0" SelectionChanged="Filter_Changed"/>

                <TextBlock Grid.Column="2" Text="文件类型：" VerticalAlignment="Center" FontSize="12"
                           Foreground="#4A5568" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbExtension" Grid.Column="3" Width="110" Height="28" FontSize="12"
                          Margin="0,0,14,0" SelectionChanged="Filter_Changed"/>

                <TextBlock Grid.Column="4" x:Name="TxtCount" VerticalAlignment="Center"
                           FontSize="11" Foreground="#718096"/>

                <Button x:Name="BtnDeleteSelected" Grid.Column="5"
                        Content="移除选中项" Margin="0,0,8,0"
                        Background="#E74C3C" Foreground="White" BorderThickness="0"
                        Style="{StaticResource ToolBtn}" IsEnabled="False"
                        Click="BtnDeleteSelected_Click"/>
                <Button x:Name="BtnSelectAll" Grid.Column="6"
                        Content="全选当前页" 
                        Background="#718096" Foreground="White" BorderThickness="0"
                        Style="{StaticResource ToolBtn}"
                        Click="BtnSelectAll_Click"/>
            </Grid>
        </Border>

        <!-- File list -->
        <ListView x:Name="FileList" Grid.Row="2"
                  SelectionMode="Extended"
                  BorderThickness="0" Background="White"
                  SelectionChanged="FileList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="200"
                                    DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="类型" Width="60"
                                    DisplayMemberBinding="{Binding Extension}"/>
                    <GridViewColumn Header="来源" Width="80"
                                    DisplayMemberBinding="{Binding Source}"/>
                    <GridViewColumn Header="命中规则" Width="200"
                                    DisplayMemberBinding="{Binding PatternSummary}"/>
                    <GridViewColumn Header="完整路径" Width="340"
                                    DisplayMemberBinding="{Binding FilePath}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="14,5" Background="#F7FAFC"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" FontSize="11" Foreground="#718096"
                       Text="提示：移除操作仅从本次报告中排除，不会删除磁盘上的实际文件。"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Width="100" Height="34" FontSize="12"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Style="{StaticResource ToolBtn}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
