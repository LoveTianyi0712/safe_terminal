<Window x:Class="EndpointComplianceChecker.Views.SensitivePatternsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="敏感数据规则配置"
        Width="780" Height="560"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A5F" Padding="20,14">
            <StackPanel>
                <TextBlock Text="🔍 敏感数据规则配置" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="管理用于扫描文件的正则表达式规则，支持手机号、身份证、自定义数据类型" Foreground="#A8C6DA" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main content: left = list, right = edit form -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: pattern list -->
            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- List header -->
                    <Border Grid.Row="0" Background="#F7FAFC" CornerRadius="6,6,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="规则列表" FontWeight="SemiBold" FontSize="12" Foreground="#4A5568"/>
                    </Border>

                    <ListView x:Name="PatternList" Grid.Row="1"
                              BorderThickness="0" Background="Transparent"
                              SelectionChanged="PatternList_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="类型名称" Width="110"
                                                DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="正则表达式" Width="190"
                                                DisplayMemberBinding="{Binding Regex}"/>
                                <GridViewColumn Header="阈值" Width="50"
                                                DisplayMemberBinding="{Binding MinFileCount}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- List toolbar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,6"
                                HorizontalAlignment="Left">
                        <Button x:Name="BtnAdd" Content="+ 新增" Margin="0,0,6,0"
                                Background="#27AE60" Foreground="White" BorderThickness="0"
                                Style="{StaticResource ToolBtn}" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnDelete" Content="删除" Margin="0,0,6,0"
                                Background="#E74C3C" Foreground="White" BorderThickness="0"
                                Style="{StaticResource ToolBtn}" IsEnabled="False"
                                Click="BtnDelete_Click"/>
                        <Button x:Name="BtnReset" Content="恢复默认"
                                Background="#718096" Foreground="White" BorderThickness="0"
                                Style="{StaticResource ToolBtn}" Click="BtnReset_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: edit form + test -->
            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="编辑规则" FontWeight="SemiBold" FontSize="12"
                               Foreground="#4A5568" Margin="0,0,0,12"/>

                    <!-- Type -->
                    <TextBlock Grid.Row="1" Text="类型名称" FontSize="11" Foreground="#718096" Margin="0,0,0,3"/>
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="TxtType" Height="30" Padding="8,0"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 BorderBrush="#CBD5E0"
                                 TextChanged="EditField_Changed"/>
                        <TextBlock Text="例如：手机号、银行卡号" FontSize="12" Foreground="#A0AEC0"
                                   Padding="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtType}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Regex -->
                    <TextBlock Grid.Row="3" Text="正则表达式" FontSize="11" Foreground="#718096" Margin="0,0,0,3"/>
                    <Grid Grid.Row="4" Margin="0,0,0,10">
                        <TextBox x:Name="TxtRegex" Height="60" Padding="8,6"
                                 AcceptsReturn="False" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New" FontSize="12"
                                 BorderBrush="#CBD5E0"
                                 TextChanged="EditField_Changed"/>
                        <TextBlock Text="例如：(?&lt;!\d)1[3-9]\d{9}(?!\d)" FontSize="12" Foreground="#A0AEC0"
                                   Padding="10,8" VerticalAlignment="Top" IsHitTestVisible="False"
                                   FontFamily="Consolas, Courier New">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtRegex}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Threshold -->
                    <StackPanel Grid.Row="5" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="报告显示阈值（文件数）" FontSize="11" Foreground="#718096"/>
                            <TextBlock Text="  ?" FontSize="10" Foreground="#2E86AB" Cursor="Hand"
                                       ToolTip="扫描到的命中文件数超过此值才会出现在报告中。&#10;设为 0 表示不限制，所有命中均显示。"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtThreshold" Grid.Column="0"
                                     Height="30" Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#CBD5E0" BorderThickness="1"
                                     Background="White" FontSize="12"
                                     Text="0"
                                     TextChanged="EditField_Changed"/>
                            <TextBlock Grid.Column="1" Text="个文件" FontSize="11"
                                       Foreground="#718096" VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="0 = 不限制，命中 ≥ 阈值才写入报告"
                                   FontSize="10" Foreground="#A0AEC0" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button x:Name="BtnApply" Grid.Row="6" Content="应用修改" Height="30"
                            VerticalAlignment="Top"
                            Background="#2E86AB" Foreground="White" BorderThickness="0"
                            Style="{StaticResource ToolBtn}" IsEnabled="False"
                            Click="BtnApply_Click"/>

                    <!-- Separator -->
                    <Border Grid.Row="7" Height="1" Background="#E2E8F0" Margin="0,12"/>

                    <!-- Test area -->
                    <StackPanel Grid.Row="8">
                        <TextBlock Text="实时测试" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#4A5568" Margin="0,0,0,6"/>
                        <TextBlock Text="测试文本（粘贴后自动匹配）" FontSize="11" Foreground="#718096" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,6">
                            <TextBox x:Name="TxtTestInput" Height="60" Padding="8,6"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     FontSize="12" BorderBrush="#CBD5E0"
                                     TextChanged="TxtTestInput_Changed"/>
                            <TextBlock Text="粘贴要测试的文本…" FontSize="12" Foreground="#A0AEC0"
                                       Padding="10,8" VerticalAlignment="Top" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtTestInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="TestResultBorder" CornerRadius="4" Padding="8,6"
                                Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock x:Name="TxtTestResult" FontSize="11" TextWrapping="Wrap"
                                       Foreground="#718096" Text="在上方输入文本后自动显示匹配结果"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="16,4" Background="#F7FAFC"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" FontSize="11" Foreground="#718096"
                       Text="提示：修改后点击「保存」生效，扫描时自动加载最新规则。"/>
        </Border>

        <!-- Footer buttons -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="80" Height="34" FontSize="12" Margin="0,0,10,0"
                        Background="#EDF2F7" Foreground="#4A5568"
                        BorderBrush="#CBD5E0" BorderThickness="1"
                        Style="{StaticResource ToolBtn}" Click="BtnCancel_Click"/>
                <Button Content="保存规则" Width="100" Height="34" FontSize="12" FontWeight="SemiBold"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Style="{StaticResource ToolBtn}" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
